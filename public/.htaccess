<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to real files/dirs (assets), otherwise front controller.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [L]
</IfModule>

# Basic hardening: never serve dotfiles or hidden folders.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
