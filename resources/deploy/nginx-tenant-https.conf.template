# Managed tenant HTTPS virtual host.
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;
    root "__PUBLIC_ROOT__";
    index index.php;
    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /assets/vendor/jssip-3.13.9.mjs { types { application/javascript mjs; } try_files $uri =404; }
    location = /ws {
        if ($http_origin != "https://__DOMAIN__") { return 403; }
        proxy_pass http://127.0.0.1:8088/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_read_timeout 3600s;
    }
    include /etc/nginx/snippets/asterisk-panel-recordings.conf;
    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_param APP_URL https://__DOMAIN__;
        fastcgi_param APP_SECURE_COOKIES 1;
        fastcgi_pass unix:__PHP_SOCKET__;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
