# Asterisk Panel environment configuration.
#
# Copy this file to `.env` (same directory as this one) and edit the values.
# Real environment variables always override values set here.
# Lines starting with # are comments. KEY=value, one per line.

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
# Absolute URL of this panel (no trailing slash). Used for asset links,
# provisioning URLs and secure cookies when it starts with https://.
APP_URL=http://localhost:8080

# Show PHP errors in the browser (never enable in production).
APP_DEBUG=0

# Server timezone (IANA name).
APP_TIMEZONE=UTC

# ------------------------------------------------------------------
# Database — SQLite by default, MySQL/MariaDB optional
# ------------------------------------------------------------------
DB_DRIVER=sqlite
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=asterisk_panel
# DB_USER=asterisk
# DB_PASS=

# ------------------------------------------------------------------
# Asterisk AMI (the panel connects to this host for status + reloads)
# ------------------------------------------------------------------
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=admin
AMI_SECRET=change-me

# Public hostname/IP phones register against.
ASTERISK_SIP_HOST=pbx.example.com
ASTERISK_SIP_PORT=5060

# Where generated Asterisk config is written (must be writable by PHP,
# or generated files fall back to storage/asterisk for manual copy).
ASTERISK_CONFIG_DIR=/etc/asterisk/asterisk_panel

# Call-recording directory the panel serves downloads from.
ASTERISK_RECORDING_DIR=/var/spool/asterisk/monitor/asterisk-panel

# ------------------------------------------------------------------
# Mail (optional — voicemail to email)
# ------------------------------------------------------------------
# MAIL_SMTP_HOST=smtp.example.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
